<!-- List row: optional icon, title and subtitle -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:minHeight="@dimen/list_row_min_height"
              android:orientation="horizontal"
              android:paddingStart="@dimen/list_row_padding"
              android:paddingTop="8dp"
              android:paddingEnd="@dimen/list_row_padding"
              android:paddingBottom="8dp">

    <ImageView
            android:id="@+id/row_icon"
            android:layout_width="@dimen/list_row_icon"
            android:layout_height="@dimen/list_row_icon"
            android:layout_marginEnd="@dimen/list_row_padding"
            android:contentDescription="@null"
            android:visibility="gone" />

    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

        <TextView
                android:id="@+id/row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="20sp" />

        <TextView
                android:id="@+id/row_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
