<!-- All apps: title, bar with search and sort (fixed width: changing it doesn't move the search box),
     sections per category (added from code) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:paddingStart="@dimen/safe_area_horizontal"
              android:paddingTop="@dimen/safe_area_vertical"
              android:paddingEnd="@dimen/safe_area_horizontal">

    <!-- Same ids as the standard grid: ThemeStyler.styleGridScreen colors them -->
    <TextView
            android:id="@+id/grid_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="@string/all_apps"
            android:textColor="@android:color/white"
            android:textSize="28sp" />

    <TextView
            android:id="@+id/grid_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/all_apps_menu_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <EditText
                android:id="@+id/app_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/all_apps_search_hint"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="18sp" />

        <TextView
                android:id="@+id/app_sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="@dimen/all_apps_sort_width"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
    </LinearLayout>

    <!-- The ScrollView scrolls by itself to show the focused tile. It clips content at its edges
         (so scrolling doesn't pass over title and search); negative margins and padding leave room
         for the tile zoom at the sides -->
    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/all_apps_zoom_room_negative"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/all_apps_zoom_room_negative"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/all_apps_zoom_room"
            android:paddingEnd="@dimen/all_apps_zoom_room"
            android:paddingBottom="@dimen/safe_area_vertical"
            android:scrollbars="none">

        <LinearLayout
                android:id="@+id/app_sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
