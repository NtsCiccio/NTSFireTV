<!-- Dock reordering (M9): same tile row as the home -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:clipChildren="false"
              android:clipToPadding="false"
              android:orientation="vertical"
              android:paddingStart="@dimen/safe_area_horizontal"
              android:paddingTop="@dimen/safe_area_vertical"
              android:paddingEnd="@dimen/safe_area_horizontal"
              android:paddingBottom="@dimen/safe_area_vertical">

    <TextView
            android:id="@+id/dock_order_title"
            android:fontFamily="sans-serif-light"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_dock" />

    <TextView
            android:id="@+id/dock_order_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dock_order_hint"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

    <LinearLayout
            android:id="@+id/dock_order_row"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

    <TextView
            android:id="@+id/dock_order_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
            android:text="@string/dock_order_reset"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

</LinearLayout>
