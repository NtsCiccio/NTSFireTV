<!-- Tile grid (All apps, wallpaper picker): title, optional message, scrolling grid -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:clipChildren="false"
              android:clipToPadding="false"
              android:orientation="vertical"
              android:paddingStart="@dimen/safe_area_horizontal"
              android:paddingTop="@dimen/safe_area_vertical"
              android:paddingEnd="@dimen/safe_area_horizontal">

    <TextView
            android:id="@+id/grid_title"
            android:fontFamily="sans-serif-light"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    <TextView
            android:id="@+id/grid_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />

    <!-- The ScrollView scrolls by itself to show the focused tile -->
    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="16dp"
            android:paddingBottom="@dimen/safe_area_vertical"
            android:scrollbars="none">

        <!-- 6 columns × (128dp + 16dp) = 864dp, the whole usable area -->
        <GridLayout
                android:id="@+id/tile_grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="6" />
    </ScrollView>

</LinearLayout>
